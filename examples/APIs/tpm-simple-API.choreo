#withaxioms verifies
#noaxioms gives false attack
functions:
public session: bitstring
public extend: bitstring
public created: bitstring
public created': bitstring
public envelope: bitstring
public refuse: bitstring
public obtain: bitstring
public requestdcrypt: bitstring
public extended: bitstring
public create: bitstring
public inited: bitstring
public boot2: bitstring
public dummy: bitstring

public hash: (bitstring, bitstring) -> bitstring

public boot: bitstring
public booted: bitstring

public pcr: bitstring
public key_storage: bitstring

public error: bitstring

cells: tpm_mem

agents: alice Parent tpm User

knowledge: 
User knows alice Parent tpm pk(tpm) inv(pk(tpm)).
tpm knows alice Parent tpm pk(tpm) inv(pk(tpm)).

events: 
event enveloped(bitstring, bitstring)
event opened(bitstring, bitstring)
event refused(bitstring)

queries:

choreo:

User : {
User: new N. 
User -> tpm: (boot,crypt((session,N),pk(tpm))).
tpm:
    new K/inv(K).
    new Sid. 
    tpm_mem[Sid] := (boot,inv(K),K).
tpm -> User: (extended,Sid,sign((created,K,N,Sid),inv(pk(tpm)))).
end
+
User: new Sid.
User -> tpm: (extend,refuse,Sid).
tpm: (boot,inv(K),K) := tpm_mem[Sid].tpm_mem[Sid] := refuse. tpm: event refused(Sid). 
tpm -> User: (extended,refuse).
end
+
User: new K. new V . new Sid . new N.
User -> tpm: (requestdcrypt,Sid,crypt((envelope,V),K),sign((created,K,N,Sid),inv(pk(tpm)))).
tpm: (boot,inv(K),K) := tpm_mem[Sid]. tpm_mem[Sid] := requestdcrypt. tpm: event opened(V,Sid). 
tpm -> User: (envelope,V).
end
}