functions:
public nonces: bitstring
public challenge: bitstring
public verified: bitstring
public ok: bitstring
public notok: bitstring
public dummy: bitstring
public step1: bitstring
public step2: bitstring
public step3: bitstring
public step4: bitstring
public step5: bitstring
public step6: bitstring
public step7: bitstring
public session: bitstring
public answer: bitstring
public h: bitstring -> bitstring

cells: mem_nonces mem_challenge mem_verified

agents: A B ttp

knowledge: 
A knows A B ttp pk(B) pk(ttp) inv(pk(A)).
B knows B ttp pk(ttp) pk(B) inv(pk(B)).
ttp knows A B ttp pk(B) pk(ttp) inv(pk(ttp)) pk(A).

events: 

queries:

choreo:

#nonce exchange between A and B
A: new X/inv(X).
A -> B: crypt((step1,A,X),pk(B)).
B: new NB.
B -> A: crypt((step2,A,B,NB),X).

#A requests authentication from ttp and receives challenge
A -> ttp: (step3,crypt((session,A,B,X,NB),pk(ttp))).
ttp: new Challenge.
ttp -> A: (step4,Challenge).

#A answers challenge 
A -> ttp: (step5,crypt((answer,A,B,X,NB,sign(Challenge,inv(pk(A)))),pk(ttp))).
ttp -> A: (step6,A,B,ok).

#A contacts B again
A: new MSG1.
A: new K.
A -> B: (step6,A,B,sign((A,B,crypt(K,pk(B))),inv(X)),scrypt((MSG1,h((X,NB))),K)).

#B asks ttp for authentication of A
B -> ttp: (step7,A,B).
ttp -> B: sign((ok,A,B,X,NB),inv(pk(ttp))).

#B answers A
B: new MSG2.
B -> A: scrypt((MSG2,h((X,NB,MSG1))),K).
MSG1 secret between A B.
MSG2 secret between A B.
K secret between A B.
A authenticates B on MSG2.
B authenticates A on MSG1.
end