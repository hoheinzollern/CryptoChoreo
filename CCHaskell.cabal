cabal-version:      2.2
name:               CCHaskell
version:            0.1.0.0
synopsis:           CryptoChoreo: Alice-and-Bob choreographies to ProVerif/SAPIC+
license:            BSD-3-Clause
build-type:         Simple

library
    hs-source-dirs:    src, src/parsing, src/ProVerifTranslation, src/SAPICTranslation
    default-language:  Haskell2010
    build-depends:     base         >= 4.14 && < 5
                     , containers
                     , transformers
                     , mtl
                     , pretty
                     , array
                     , parsec
    build-tool-depends: alex:alex, happy:happy
    exposed-modules:   Algebraic
                     , Choreo
                     , ChoreoParser
                     , ChoreoTokenize
                     , EqClasses
                     , ExampleAlgebra
                     , ExamplePVT
                     , Frame
                     , Local
                     , LocalPretty
                     , ProtocolSetup
                     , ProVerif
                     , ProVerifPrinter
                     , ProVerifResult
                     , SAPIC
                     , SAPICPrinter
                     , SAPICSetup
                     , Term
                     , Topdec
                     , Translate
                     , TranslateState
                     , Util

executable CCHaskell
    main-is:           Main.hs
    hs-source-dirs:    app
    default-language:  Haskell2010
    build-depends:     base
                     , CCHaskell
                     , containers
                     , directory
                     , filepath
                     , process
                     , pretty
                     , transformers

test-suite spec
    type:              exitcode-stdio-1.0
    main-is:           Spec.hs
    hs-source-dirs:    test
    default-language:  Haskell2010
    build-depends:     base
                     , CCHaskell
                     , hspec
                     , containers
    other-modules:     AlgebraicSpec
                     , AtomicSpec
                     , ChoreoSpec
                     , EqClassesSpec
                     , ExampleAlgebraSpec
                     , IntegrationSpec
                     , LocalSpec
                     , ProVerifResult
                     , TermSpec
                     , TestRunner
                     , TranslateSpec
                     , UtilSpec
